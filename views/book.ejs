<%- include('_header', { title: 'Schedule & Details' }) %>

<%
  var _sp = '?package=' + encodeURIComponent(packageId) + '&addons=' + encodeURIComponent(addonIds.join(',')) + '&rush=' + (rush ? '1' : '');
  var _dp = _sp + Object.entries(query).filter(([k]) => !['package','addons','rush','bundle'].includes(k)).map(([k,v]) => '&' + encodeURIComponent(k) + '=' + encodeURIComponent(v||'')).join('');
%>
<%- include('_nav', { currentStep: 4, stepUrls: { 1: '/your-info', 2: '/' + _sp, 3: '/details' + _dp } }) %>

<form id="book-form" action="/book" method="POST" class="book-form" novalidate>

  <!-- Hidden booking state -->
  <input type="hidden" name="packageId" value="<%= packageId %>">
  <% for (const a of addonIds) { %>
  <input type="hidden" name="addonIds" value="<%= a %>">
  <% } %>
  <input type="hidden" name="rush"     value="<%= rush ? '1' : '0' %>">
  <input type="hidden" name="startISO" id="startISO" value="">
  <!-- Honeypot -->
  <input type="text"   name="website"  style="display:none" tabindex="-1" autocomplete="off">

  <!-- Property data (carried from /details via query params) -->
  <%
    const propAddr  = [query.address, query.city, query.state, query.zip].filter(Boolean).join(', ');
    const accessStr = [query.access_method, query.access_notes].filter(Boolean).join(' — ');
    const noteParts = [
      query.rooms            ? 'Rooms: '       + query.rooms            : '',
      query.prop_status      ? 'Status: '      + query.prop_status      : '',
      query.site_time        ? 'Time on site: '+ query.site_time        : '',
      query.listing_deadline ? 'Deadline: '    + query.listing_deadline : '',
      query.prop_ready       ? 'Ready: '       + query.prop_ready       : '',
      query.known_issues     ? 'Issues: '      + query.known_issues     : '',
      query.exterior_issues  ? 'Exterior: '    + query.exterior_issues  : '',
      query.lights_on        ? 'Lights: '      + query.lights_on        : '',
      query.hvac_on          ? 'HVAC: '        + query.hvac_on          : '',
    ].filter(Boolean).join(' | ');
  %>
  <input type="hidden" name="propertyAddress"    value="<%= propAddr %>">
  <input type="hidden" name="propertySqft"       value="<%= query.sqft || '' %>">
  <input type="hidden" name="accessInstructions" value="<%= accessStr %>">
  <input type="hidden" name="notes"              value="<%= noteParts %>">
  <input type="hidden" name="mlsNumber"          value="<%= query.mls_number || '' %>">
  <input type="hidden" name="listPrice"          value="<%= query.list_price || '' %>">
  <input type="hidden" name="bedrooms"           value="<%= query.bedrooms || '' %>">
  <input type="hidden" name="bathrooms"          value="<%= query.bathrooms || '' %>">
  <input type="hidden" name="yearBuilt"          value="<%= query.year_built || '' %>">
  <input type="hidden" name="lotSize"            value="<%= query.lot_size || '' %>">
  <input type="hidden" name="propStatus"         value="<%= query.prop_status || '' %>">
  <input type="hidden" name="publicRemarks"      value="<%= query.public_remarks || '' %>">
  <input type="hidden" name="propertyType"       value="<%= query.property_type || 'residential' %>">
  <input type="hidden" name="hasBasement"        value="<%= query.has_basement || '' %>">
  <input type="hidden" name="hasGarage"          value="<%= query.has_garage || '' %>">
  <input type="hidden" name="hasBarn"            value="<%= query.has_barn || '' %>">
  <input type="hidden" name="hasPoolHouse"       value="<%= query.has_pool_house || '' %>">
  <input type="hidden" name="hasGuestHouse"      value="<%= query.has_guest_house || '' %>">
  <input type="hidden" name="hasWorkshop"        value="<%= query.has_workshop || '' %>">
  <input type="hidden" name="hasShed"            value="<%= query.has_shed || '' %>">
  <input type="hidden" name="hasCarriageHouse"   value="<%= query.has_carriage_house || '' %>">
  <input type="hidden" name="hasBoathouse"       value="<%= query.has_boathouse || '' %>">
  <input type="hidden" name="rooms"              value="<%= query.rooms || '' %>">
  <input type="hidden" name="siteTime"           value="<%= query.site_time || '' %>">
  <input type="hidden" name="listingDeadline"    value="<%= query.listing_deadline || '' %>">
  <input type="hidden" name="propReady"          value="<%= query.prop_ready || '' %>">
  <input type="hidden" name="lightsOn"           value="<%= query.lights_on || '' %>">
  <input type="hidden" name="hvacOn"             value="<%= query.hvac_on || '' %>">
  <input type="hidden" name="knownIssues"        value="<%= query.known_issues || '' %>">
  <input type="hidden" name="exteriorIssues"     value="<%= query.exterior_issues || '' %>">
  <input type="hidden" name="deliveryEmail"      value="<%= query.delivery_email || '' %>">
  <input type="hidden" name="coAgentName"        value="<%= query.co_agent_name || '' %>">
  <input type="hidden" name="coAgentEmail"       value="<%= query.co_agent_email || '' %>">
  <input type="hidden" name="tcName"             value="<%= query.tc_name || '' %>">
  <input type="hidden" name="tcEmail"            value="<%= query.tc_email || '' %>">
  <input type="hidden" name="agentNotes"         value="<%= query.agent_notes || '' %>">

  <div class="book-layout">

    <!-- Left: calendar + slots -->
    <div class="book-left">
      <section class="form-section">
        <h2>Select Date</h2>
        <div id="calendar-container">
          <div class="cal-nav">
            <button type="button" id="cal-prev" class="cal-arrow">&#8592;</button>
            <span id="cal-month-label" class="cal-month"></span>
            <button type="button" id="cal-next" class="cal-arrow">&#8594;</button>
          </div>
          <div id="calendar-grid" class="cal-grid"></div>
        </div>
      </section>

      <section class="form-section" id="slots-section" style="display:none">
        <h2>Available Times</h2>
        <div id="slots-grid" class="slots-grid"></div>
        <p id="slots-empty" class="slots-empty" style="display:none">No availability on this date. Try another day.</p>
      </section>
    </div>

    <!-- Right: order summary + booking-as card + submit -->
    <div class="book-right">

      <div class="order-summary card">
        <h3>Order Summary</h3>
        <% for (const li of quote.lineItems) { %>
        <div class="os-row"><span><%= li.name %></span><span>$<%= li.amount.toFixed(2) %></span></div>
        <% } %>
        <% if (quote.tax > 0) { %>
        <div class="os-row os-tax"><span>OH Sales Tax (<%= (quote.taxRate * 100).toFixed(1) %>%)</span><span>$<%= quote.tax.toFixed(2) %></span></div>
        <% } %>
        <div class="os-row os-total"><span>Total Due</span><span>$<%= quote.total.toFixed(2) %></span></div>
        <p class="os-note">Full payment due at booking via Wave invoice.</p>
      </div>

      <!-- Booking-as card -->
      <div class="booking-as card">
        <div class="booking-as-info">
          <strong><%= contact.name %></strong>
          <span><%= contact.email %></span>
          <span><%= contact.phone %></span>
          <% if (contact.brokerage) { %><span><%= contact.brokerage %></span><% } %>
          <% if (contact.brokerageAddress) { %><span><%= contact.brokerageAddress %></span><% } %>
        </div>
        <a href="/your-info" class="booking-as-edit">Edit</a>
      </div>

      <div class="policy-block">
        <h3>Payment &amp; Policies</h3>
        <ul>
          <li>Full payment due at booking via Wave invoice.</li>
          <li>Free cancellation 48+ hours before shoot.</li>
          <li>$50 fee for cancellations within 24–48 hours.</li>
          <li>Photos delivered within 24 hours of shoot.</li>
        </ul>
        <label class="agree-label">
          <input type="checkbox" name="agreed" required id="agree-check">
          I have read and agree to the <a href="https://digflatmedia.com" target="_blank">booking policies</a>.
        </label>
      </div>

      <button type="submit" class="btn-primary btn-block" id="submit-btn" disabled>
        Review &amp; Pay →
      </button>
      <p id="submit-hint" class="submit-hint">Select a date and time to continue.</p>
    </div>

  </div><!-- /.book-layout -->
</form>

<script>
window.BOOK_CONFIG = {
  packageId: '<%= packageId %>',
  addonIds:  <%- JSON.stringify(addonIds) %>,
  minDate:   '<%= minDate %>',
  maxDate:   '<%= maxDate %>',
  apiBase:   '',
};
</script>
<%- include('_footer') %>
