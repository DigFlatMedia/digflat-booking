<%- include('_admin_header', { title: 'Google Calendar' }) %>

<h1 class="text-2xl font-bold mb-6">Google Calendar</h1>

<div class="bg-white rounded-lg shadow p-6 max-w-lg">
  <% if (connected) { %>
  <div class="flex items-center gap-3 mb-4">
    <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
    <span class="font-medium text-green-700">Connected</span>
  </div>
  <p class="text-sm text-gray-600 mb-6">
    DigFlat Booking is reading your calendar to check availability and will add events when bookings are confirmed.
  </p>
  <form action="/admin/google/disconnect" method="POST" onsubmit="return confirm('Disconnect Google Calendar?')">
    <button class="px-4 py-2 border border-red-300 text-red-600 rounded hover:bg-red-50 text-sm">Disconnect</button>
  </form>
  <% } else { %>
  <div class="flex items-center gap-3 mb-4">
    <span class="w-3 h-3 rounded-full bg-gray-400 inline-block"></span>
    <span class="font-medium text-gray-500">Not connected</span>
  </div>
  <p class="text-sm text-gray-600 mb-2">Connect your Google Calendar to:</p>
  <ul class="text-sm text-gray-600 list-disc ml-5 mb-6 space-y-1">
    <li>Automatically block times when you're busy</li>
    <li>Create calendar events when bookings are paid</li>
  </ul>
  <a href="<%= authUrl %>" class="inline-block px-5 py-2.5 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm font-medium">
    Connect Google Calendar →
  </a>
  <p class="text-xs text-gray-400 mt-3">You'll be redirected to Google to grant calendar access. Tokens are stored securely on disk.</p>
  <% } %>
</div>

<%- include('_admin_footer') %>
