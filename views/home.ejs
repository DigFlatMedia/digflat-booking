<%- include('_header', { title: 'Book a Shoot' }) %>

<%- include('_nav', { currentStep: 2, stepUrls: { 1: '/your-info', 3: '/details', 4: '/book' } }) %>

<form id="booking-form" action="/details" method="GET" class="service-picker">

  <!-- Property type toggle -->
  <section class="picker-section">
    <h2>Property Type</h2>
    <p class="section-sub">Select the type of property you're booking for.</p>
    <div class="type-toggle">
      <button type="button" class="type-btn active" id="btn-residential" onclick="setPropertyType('residential')">Residential</button>
      <button type="button" class="type-btn" id="btn-commercial" onclick="setPropertyType('commercial')">Commercial</button>
    </div>
    <input type="hidden" name="property_type" id="property_type" value="<%= query.property_type || 'residential' %>">
  </section>

  <!-- Residential services -->
  <div id="residential-services">

  <!-- Photo packages -->
  <section class="picker-section" id="section-custom">
    <h2>Photo Package</h2>
    <p class="section-sub">Start with a photo package, then add what you need.</p>

    <div class="package-grid">
      <label class="package-card" data-package-id="none">
        <input type="radio" name="package" value="none" class="pkg-radio" <%= query.package === 'none' ? 'checked' : '' %>>
        <strong class="pkg-name">No Photo</strong>
        <p class="pkg-desc">Skip the photo package — pick this if you only need video, floor plan, or drone.</p>
        <p class="pkg-desc" style="margin-top:6px;color:var(--muted)">You can add photos to your shoot anytime before delivery.</p>
        <span class="pkg-skip">Skip — no photo</span>
      </label>
      <% for (const p of pricing.photo_packages) { %>
      <label class="package-card" data-package-id="<%= p.id %>">
        <input type="radio" name="package" value="<%= p.id %>" class="pkg-radio"
          <%= (!query.bundle && (query.package === p.id || (!query.package && p.is_default))) ? 'checked' : '' %>>
        <strong class="pkg-name"><%= p.name %></strong>
        <span class="pkg-sqft"><%= p.sqft_max ? p.sqft_min.toLocaleString() + ' – ' + p.sqft_max.toLocaleString() : p.sqft_min.toLocaleString() + '+' %> sq ft</span>
        <p class="pkg-desc"><%= p.description %></p>
        <div class="pkg-includes">
          <% for (const inc of p.includes) { %><div class="inc-item">✓ <%= inc %></div><% } %>
        </div>
        <span class="pkg-price">$<%= p.price %></span>
      </label>
      <% } %>
    </div>

  </section>

  <!-- Photo Add-on: Social Walkthrough (sits between Photo and Video sections) -->
  <% var _photoAddons = pricing.add_ons.filter(a => a.category === 'photo'); %>
  <% if (_photoAddons.length) { %>
  <section class="picker-section">
    <h2>Photo Add-Ons</h2>
    <p class="section-sub">Optional extras that pair with your photo package.</p>
    <div class="addon-grid">
      <% for (const a of _photoAddons) { %>
      <label class="addon-card" data-addon-id="<%= a.id %>">
        <input type="checkbox" name="addons" value="<%= a.id %>" class="addon-check"
          <%= (query.addons || '').split(',').includes(a.id) ? 'checked' : '' %>>
        <strong class="addon-name"><%= a.name %></strong>
        <% if (a.duration_seconds) { %><span class="pkg-range"><%= a.duration_seconds %>s</span><% } %>
        <p class="addon-desc"><%= a.description %></p>
        <span class="addon-price">+$<%= a.price %></span>
      </label>
      <% } %>
    </div>
  </section>
  <% } %>

  <!-- Video Package -->
  <section class="picker-section">
    <h2>Video Package</h2>
    <p class="section-sub">Add a walkthrough video to your listing — or skip to photos only.</p>
    <div class="package-grid">
      <label class="package-card">
        <input type="radio" name="video" value="none" class="video-radio" <%= !query.video || query.video === 'none' ? 'checked' : '' %>>
        <strong class="pkg-name">No Video</strong>
        <p class="pkg-desc">Photos only. You can always add video later.</p>
        <p class="pkg-desc" style="margin-top:6px;color:var(--muted)">You can add video to your shoot anytime before delivery.</p>
        <span class="pkg-skip">Skip — no video</span>
      </label>
      <% for (const v of pricing.add_ons.filter(a => a.category === 'video')) { %>
      <label class="package-card" data-addon-id="<%= v.id %>">
        <input type="radio" name="video" value="<%= v.id %>" class="video-radio"
          <%= query.video === v.id ? 'checked' : '' %>>
        <strong class="pkg-name"><%= v.name %></strong>
        <% if (v.duration_seconds) { %><span class="pkg-range"><%= v.duration_seconds %>s</span><% } %>
        <p class="pkg-desc"><%= v.description %></p>
        <% if (v.includes) { %>
        <div class="pkg-includes">
          <% for (const inc of v.includes) { %><div class="inc-item">✓ <%= inc %></div><% } %>
        </div>
        <% } %>
        <span class="pkg-price"><% if (v.discount_from_individual) { %><span class="pkg-save">Save $<%= v.discount_from_individual %></span> <% } %>$<%= v.price %></span>
      </label>
      <% } %>
    </div>
  </section>

  <!-- Video Add-Ons (greyed out when "No Video" is selected) -->
  <% var _videoAddons = pricing.add_ons.filter(a => a.category === 'video_addon'); %>
  <% if (_videoAddons.length) { %>
  <section class="picker-section" id="video-addon-section">
    <h2>Video Add-Ons</h2>
    <p class="section-sub">Available when a video package is selected.</p>
    <div class="addon-grid">
      <% for (const a of _videoAddons) { %>
      <label class="addon-card" data-addon-id="<%= a.id %>">
        <input type="checkbox" name="addons" value="<%= a.id %>" class="addon-check"
          <%= (query.addons || '').split(',').includes(a.id) ? 'checked' : '' %>>
        <strong class="addon-name"><%= a.name %></strong>
        <p class="addon-desc"><%= a.description %></p>
        <span class="addon-price">+$<%= a.price %></span>
      </label>
      <% } %>
    </div>
  </section>
  <% } %>

  <!-- Drone (sits directly under Video Package) -->
  <% var _droneAddons = pricing.add_ons.filter(a => a.category === 'drone'); %>
  <% if (_droneAddons.length) { %>
  <section class="picker-section">
    <h2>Drone</h2>
    <p class="section-sub">Aerial coverage of the property and surrounding area — pick what you need.</p>
    <div class="addon-grid">
      <% for (const a of _droneAddons) { %>
      <label class="addon-card" data-addon-id="<%= a.id %>" data-requires="<%= (a.requires || []).join(',') %>">
        <input type="checkbox" name="addons" value="<%= a.id %>" class="addon-check"
          <%= (query.addons || '').split(',').includes(a.id) ? 'checked' : '' %>>
        <strong class="addon-name"><%= a.name %></strong>
        <% if (a.requires && a.requires.length) { %>
          <span class="addon-req">Requires: Full Cinematic Walkthrough</span>
        <% } %>
        <p class="addon-desc"><%= a.description %></p>
        <span class="addon-price">+$<%= a.price %></span>
      </label>
      <% } %>
    </div>
  </section>
  <% } %>

  <!-- Floor Plan -->
  <section class="picker-section" id="floorplan-section">
    <h2>Floor Plan</h2>
    <p class="section-sub">A basic 2D floor plan is included free with any photo package. Skip if you don't need one.</p>
    <div class="package-grid">
      <label class="package-card">
        <input type="radio" name="floorplan" value="none" class="floorplan-radio" <%= query.floorplan === 'none' ? 'checked' : '' %>>
        <strong class="pkg-name">No Floor Plan</strong>
        <p class="pkg-desc">Skip the floor plan for this shoot.</p>
        <span class="pkg-price">$0</span>
      </label>
      <% for (const f of pricing.add_ons.filter(a => a.category === 'floor_plan')) { %>
      <label class="package-card">
        <input type="radio" name="floorplan" value="<%= f.id %>" class="floorplan-radio" <%= (!query.floorplan && f.id === 'addon_floor_plan_basic' || query.floorplan === f.id) ? 'checked' : '' %>>
        <strong class="pkg-name"><%= f.name %></strong>
        <% if (f.provider) { %><span class="pkg-range">via <%= f.provider %></span><% } %>
        <p class="pkg-desc"><%= f.description %></p>
        <div class="pkg-includes">
          <% for (const inc of f.includes) { %><div class="inc-item">✓ <%= inc %></div><% } %>
        </div>
        <span class="pkg-price"><%= f.price === 0 ? 'Free' : '+$' + f.price %></span>
      </label>
      <% } %>
    </div>
  </section>

  <!-- Add-ons -->
  <section class="picker-section">
    <h2>Add-ons</h2>
    <div class="addon-grid">
      <% for (const a of pricing.add_ons.filter(a => !['video', 'floor_plan', 'photo', 'drone', 'video_addon'].includes(a.category))) { %>
      <label class="addon-card" data-addon-id="<%= a.id %>" data-requires="<%= (a.requires || []).join(',') %>">
        <input type="checkbox" name="addons" value="<%= a.id %>" class="addon-check"
          <%= (query.addons || '').split(',').includes(a.id) ? 'checked' : '' %>>
        <strong class="addon-name"><%= a.name %></strong>
        <% if (a.requires && a.requires.length) { %>
          <span class="addon-req">Requires: Full Cinematic Walkthrough</span>
        <% } %>
        <p class="addon-desc"><%= a.description %></p>
        <span class="addon-price">+$<%= a.price %></span>
      </label>
      <% } %>
    </div>
  </section>


  </div><!-- /#residential-services -->

  <!-- Commercial services -->
  <div id="commercial-services" style="display:none">
    <section class="picker-section">
      <div class="coming-soon-block">
        <h3>Commercial Pricing Coming Soon</h3>
        <p>We're building out commercial packages for office spaces, retail, industrial, and multi-unit properties. <a href="mailto:hello@digflatmedia.com">Contact us</a> for a custom quote.</p>
      </div>
    </section>
  </div><!-- /#commercial-services -->

  <div style="height:48px"></div>

  <!-- Live price summary -->
  <div class="price-summary" id="price-summary">
    <div class="ps-loading">Calculating…</div>
  </div>

  <div class="cta-row">
    <button type="submit" class="btn-primary" id="continue-btn">Continue to Schedule →</button>
  </div>

</form>

<script>
// Embedded pricing data for client-side display.
window.PRICING = <%- JSON.stringify(pricing) %>;
</script>

<%- include('_footer') %>
