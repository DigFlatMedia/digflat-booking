<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>DigFlat Media Booking</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&family=Nunito+Sans:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap">
  <link rel="stylesheet" href="/public/styles.css">
  <% if (locals.embed) { %>
  <style>
    /* Embed mode: integrated into host site — strip standalone chrome */
    .site-header { display: none !important; }
    .site-footer { display: none !important; }
    .main-content { min-height: unset; }
    body { background: transparent; }
    /* Push the editorial header card well clear of the Squarespace site nav
       so the booking title doesn't sit underneath the host page's header. */
    .bk-wrap   { margin-top: 120px; }
    .bk-header { box-shadow: 0 1px 4px rgba(0,0,0,.05); }
  </style>
  <% } %>
</head>
<body<% if (locals.embed) { %> class="embed-mode"<% } %>>
  <main class="main-content">
