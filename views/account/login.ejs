<%- include('../_header', { title: 'Sign In' }) %>

<div class="auth-page">
  <div class="auth-card">
    <h1>Sign In</h1>
    <p class="auth-sub">We'll email you a sign-in link — no password needed.</p>

    <% if (sent) { %>
    <div class="notice notice-ok">
      <strong>Check your inbox.</strong> A sign-in link has been sent to <strong><%= sent %></strong>. It expires in 30 minutes.
    </div>
    <% } else { %>

    <% if (error) { %><div class="notice notice-err"><%= error %></div><% } %>

    <form action="/account/login" method="POST" class="auth-form">
      <!-- Honeypot -->
      <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off">
      <div class="field-group">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" required autofocus placeholder="you@brokerage.com">
      </div>
      <button type="submit" class="btn-primary btn-block">Send Sign-In Link</button>
    </form>

    <p class="auth-guest">Booking as a guest? <a href="/">No account needed →</a></p>
    <% } %>
  </div>
</div>

<%- include('../_footer') %>
