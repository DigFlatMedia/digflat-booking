<%
  var _total   = locals.totalSteps || 5;
  var _cur     = locals.currentStep || 1;
  var _title   = locals.navTitle || 'Real estate photo & video';
  var _pct     = (_cur / _total * 100).toFixed(2);
  var _counter = String(_cur).padStart(2, '0') + ' / ' + String(_total).padStart(2, '0');
  var _names   = ['Your info', 'Choose services', 'Property', 'Date & time', 'Confirm'];
  var _urls    = locals.stepUrls || {};
%>
<div class="bk-wrap">
  <div class="bk-header">

    <div class="bk-top">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2 A10 10 0 0 1 22 12" stroke="#3FBFD9" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M22 12 A10 10 0 0 1 17 20.6" stroke="#5a6770" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M12 22 A10 10 0 0 1 2 12" stroke="#5a6770" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <div class="bk-center">
        <div class="bk-eyebrow">BOOK A SHOOT</div>
        <div class="bk-title"><%= _title %></div>
      </div>
      <div class="bk-counter"><%= _counter %></div>
    </div>

    <div class="bk-progress-track">
      <div class="bk-progress-fill" style="width:<%= _pct %>%"></div>
    </div>

    <div class="bk-steps">
      <% _names.forEach(function(name, i) {
        var n   = i + 1;
        var url = _urls[n];
      %>
        <% if (n < _cur && url) { %>
        <a href="<%= url %>" class="bk-step bk-step--done"><%= name %></a>
        <% } else if (n === _cur) { %>
        <span class="bk-step bk-step--active"><%= name %></span>
        <% } else { %>
        <span class="bk-step bk-step--upcoming"><%= name %></span>
        <% } %>
      <% }); %>
    </div>

  </div>
</div>
