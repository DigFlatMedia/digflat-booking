# Public URL (no trailing slash)
PUBLIC_URL=https://book.digflatmedia.com

# Operator
OPERATOR_EMAIL=bryan@digflat.com
OPERATOR_NAME=Bryan Burton

# Admin Basic Auth (admin area)
ADMIN_USER=bryan
ADMIN_PASS=change-me-to-something-long

# Cookie/session secret — used to sign customer login cookies. Random 64+ chars.
SESSION_SECRET=change-me-random-64-char-string

# Storage path on Render persistent disk (mount at /var/data in render.yaml)
DATA_DIR=./data

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev

# --- Google Calendar OAuth ---
# Create OAuth client at console.cloud.google.com -> APIs & Services -> Credentials
# Authorized redirect URI must be: $PUBLIC_URL/admin/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
# Calendar to read busy times from + write events to. "primary" works.
GOOGLE_CALENDAR_ID=primary

# --- Wave (waveapps.com) ---
# From Wave -> profile menu -> Developer Portal -> Manage Applications -> Full Access Token
WAVE_API_TOKEN=xxxx
WAVE_BUSINESS_ID=xxxx-xxxx-xxxx
# Webhook signing secret from Wave webhook subscription UI
WAVE_WEBHOOK_SECRET=xxxx

# --- Google Distance Matrix (optional, for >50mi auto-flag) ---
# Leave blank to skip distance check (manual review of every address)
GOOGLE_MAPS_API_KEY=

# Port (Render sets this automatically)
PORT=3000
